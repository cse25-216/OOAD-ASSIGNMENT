<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.TransactionHistoryController"
      alignment="CENTER"
      spacing="20"
      style="-fx-background-color: #F8F5F8; -fx-padding: 25 30;">

    <HBox alignment="CENTER_LEFT"
          spacing="20"
          maxWidth="Infinity"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16 22; -fx-border-color: #F0E4EC; -fx-border-radius: 12;">

        <VBox spacing="3">
            <Label text="SASHA BANK"
                   style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #8D285D;" />

            <Label text="PERSONAL BANKING"
                   style="-fx-font-size: 10px; -fx-text-fill: #A77B94;" />
        </VBox>

        <VBox alignment="CENTER_RIGHT"
              HBox.hgrow="ALWAYS"
              spacing="3">

            <Label text="BANKING SERVICES"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #A77B94;" />

            <Label text="Transaction History"
                   style="-fx-font-size: 12px; -fx-text-fill: #563B4D;" />
        </VBox>
    </HBox>

    <VBox spacing="6"
          maxWidth="Infinity"
          style="-fx-background-color: #8D285D; -fx-background-radius: 13; -fx-padding: 20 24;">

        <Label text="ACCOUNT ACTIVITY"
               style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #F8DCEB;" />

        <Label text="Your Transaction History"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" />

        <Label text="Review your account activity, payments, deposits and withdrawals."
               wrapText="true"
               style="-fx-font-size: 12px; -fx-text-fill: #FFE1EE;" />
    </VBox>

    <VBox spacing="12"
          maxWidth="Infinity"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18 22; -fx-border-color: #F0E4EC; -fx-border-radius: 12;">

        <HBox alignment="CENTER_LEFT"
              spacing="15">

            <VBox spacing="5"
                  HBox.hgrow="ALWAYS">

                <Label text="SELECT ACCOUNT"
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #8D285D;" />

                <Label text="Choose an account to view its transaction records."
                       style="-fx-font-size: 11px; -fx-text-fill: #98758A;" />
            </VBox>

            <ComboBox fx:id="accountSelect"
                      onAction="#loadTransactions"
                      prefWidth="260"
                      prefHeight="40"
                      promptText="Choose an account"
                      style="-fx-background-color: #FFF9FC; -fx-background-radius: 8; -fx-border-color: #E8D3DF; -fx-border-radius: 8;" />

        </HBox>
    </VBox>

    <VBox spacing="12"
          maxWidth="Infinity"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #F0E4EC; -fx-border-radius: 12;">

        <HBox alignment="CENTER_LEFT"
              spacing="15">

            <VBox spacing="4"
                  HBox.hgrow="ALWAYS">

                <Label text="TRANSACTION RECORDS"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #432C3B;" />

                <Label text="Detailed account activity"
                       style="-fx-font-size: 11px; -fx-text-fill: #98758A;" />

            </VBox>

            <Label text="ACCOUNT STATEMENT"
                   style="-fx-background-color: #FFF0F6; -fx-background-radius: 20; -fx-padding: 7 12; -fx-text-fill: #8D285D; -fx-font-size: 10px; -fx-font-weight: bold;" />

        </HBox>

        <TableView fx:id="transactionTable"
                   prefHeight="380"
                   style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #F0E4EC; -fx-border-radius: 8;">

            <columns>

                <TableColumn fx:id="colAccountType"
                             text="Account"
                             prefWidth="150" />

                <TableColumn fx:id="colType"
                             text="Transaction"
                             prefWidth="150" />

                <TableColumn fx:id="colAmount"
                             text="Amount"
                             prefWidth="140" />

                <TableColumn fx:id="colBalance"
                             text="Available Balance"
                             prefWidth="170" />

                <TableColumn fx:id="colTimestamp"
                             text="Date"
                             prefWidth="220" />

            </columns>

        </TableView>

    </VBox>

    <Button text="Return to Dashboard"
            onAction="#goBack"
            prefWidth="220"
            prefHeight="40"
            style="-fx-background-color: #FFF0F5; -fx-text-fill: #8D285D; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 9; -fx-border-color: #E8D3DF; -fx-border-radius: 9; -fx-cursor: hand;" />

</VBox>
