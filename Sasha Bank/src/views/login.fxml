<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane xmlns="http://javafx.com/javafx/25"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="controllers.LoginController"
           prefWidth="800"
           prefHeight="520"
           style="-fx-background-color: #F8F3F7;">

    <VBox alignment="TOP_CENTER"
          spacing="0"
          maxWidth="800"
          maxHeight="520">

        <StackPane prefHeight="190"
                   minHeight="190"
                   maxHeight="190"
                   style="-fx-background-color: #8D285D;">

            <Circle radius="150"
                    fill="#A9437B"
                    opacity="0.35"
                    translateX="350"
                    translateY="-80"/>

            <Circle radius="105"
                    fill="#C46A9D"
                    opacity="0.18"
                    translateX="-350"
                    translateY="90"/>

            <VBox alignment="TOP_CENTER"
                  spacing="8"
                  style="-fx-padding: 30 20 0 20;">

                <Label text="SASHA BANK"
                       style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                <Label text="BANKING THAT MOVES WITH YOU"
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #F6CFE3;"/>

                <Label text="Secure. Simple. Personal."
                       style="-fx-font-size: 13px; -fx-text-fill: #FFE5F0;"/>

            </VBox>

        </StackPane>

    </VBox>

    <VBox alignment="TOP_CENTER"
          spacing="14"
          maxWidth="390"
          maxHeight="380"
          translateY="52"
          style="-fx-background-color: white;
                 -fx-background-radius: 18;
                 -fx-border-color: #F0E1EA;
                 -fx-border-radius: 18;
                 -fx-padding: 26 35 22 35;
                 -fx-effect: dropshadow(gaussian, rgba(67,44,59,0.16), 24, 0, 0, 8);">

        <VBox alignment="CENTER"
              spacing="5">

            <Label text="Welcome back"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #432C3B;"/>

            <Label text="Sign in to your personal banking account"
                   style="-fx-font-size: 12px;
                          -fx-text-fill: #98758A;"/>

        </VBox>

        <VBox spacing="7"
              maxWidth="320">

            <Label text="USERNAME"
                   style="-fx-font-size: 10px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #70445E;"/>

            <TextField fx:id="usernameField"
                       promptText="Enter your username"
                       prefHeight="42"
                       style="-fx-background-color: #FFF9FC;
                              -fx-background-radius: 8;
                              -fx-border-color: #E8D3DF;
                              -fx-border-radius: 8;
                              -fx-padding: 0 12;
                              -fx-font-size: 13px;
                              -fx-text-fill: #432C3B;"/>

        </VBox>

        <VBox spacing="7"
              maxWidth="320">

            <Label text="PASSWORD"
                   style="-fx-font-size: 10px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #70445E;"/>

            <PasswordField fx:id="passwordField"
                           promptText="Enter your password"
                           prefHeight="42"
                           onAction="#login"
                           style="-fx-background-color: #FFF9FC;
                                  -fx-background-radius: 8;
                                  -fx-border-color: #E8D3DF;
                                  -fx-border-radius: 8;
                                  -fx-padding: 0 12;
                                  -fx-font-size: 13px;
                                  -fx-text-fill: #432C3B;"/>

        </VBox>

        <Button fx:id="loginBtn"
                text="Sign In"
                onAction="#login"
                maxWidth="Infinity"
                prefHeight="43"
                style="-fx-background-color: #8D285D;
                       -fx-background-radius: 9;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;"/>

        <Label fx:id="errorLabel"
               text=""
               wrapText="true"
               maxWidth="Infinity"
               style="-fx-text-fill: #C52262;
                      -fx-font-size: 11px;
                      -fx-alignment: CENTER;"/>

        <Separator style="-fx-background-color: #F0E4EC;"/>

        <VBox alignment="CENTER"
              spacing="5">

            <Label text="YOUR MONEY. YOUR FUTURE."
                   style="-fx-font-size: 10px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #8D285D;"/>

            <Label text="Protected personal banking experience"
                   style="-fx-font-size: 10px;
                          -fx-text-fill: #98758A;"/>

        </VBox>

    </VBox>

    <Label text="© 2026 SASHA BANK"
           StackPane.alignment="BOTTOM_CENTER"
           style="-fx-padding: 0 0 10 0;
                  -fx-font-size: 10px;
                  -fx-text-fill: #98758A;"/>

</StackPane>
