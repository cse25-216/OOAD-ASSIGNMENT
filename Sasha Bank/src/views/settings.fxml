<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.SettingsController"
      spacing="25" alignment="CENTER"
      style="-fx-background-color:#E7EEF7; -fx-padding:30;">

    <Label text="Settings"
           style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#8D285D;" />

    <VBox spacing="20" alignment="CENTER"
          prefWidth="400"
          style="-fx-background-color:white; -fx-padding:25;
                 -fx-background-radius:12; -fx-border-color:#B5C5D6;
                 -fx-border-radius:12;">

        <Button text="View Profile"
                fx:id="viewProfileBtn"
                onAction="#handleViewProfile"
                prefWidth="260" prefHeight="40"
                style="-fx-background-color:#8D285D; -fx-text-fill:white;
                       -fx-font-size:16px; -fx-background-radius:10;" />

        <Button text="Close Account"
                fx:id="closeAccountBtn"
                onAction="#handleCloseAccount"
                prefWidth="260" prefHeight="40"
                style="-fx-background-color:#C0392B; -fx-text-fill:white;
                       -fx-font-size:16px; -fx-background-radius:10;" />

    </VBox>

    <Button text="Back to Dashboard"
            onAction="#goBack"
            prefWidth="220" prefHeight="40"
            style="-fx-background-color:#3F6BA6; -fx-text-fill:white;
                   -fx-background-radius:10; -fx-font-size:14px;" />

</VBox>
