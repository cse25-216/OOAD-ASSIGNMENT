<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.PaymentsController"
            prefWidth="900"
            prefHeight="600"
            style="-fx-background-color: #F8F5F8;">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="20"
              prefHeight="68"
              style="-fx-background-color: white; -fx-padding: 12 30; -fx-border-color: #F0E4EC; -fx-border-width: 0 0 1 0;">

            <VBox spacing="2">
                <Label text="SASHA BANK"
                       style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #8D285D;" />

                <Label text="PERSONAL BANKING"
                       style="-fx-font-size: 10px; -fx-text-fill: #A77B94;" />
            </VBox>

            <VBox alignment="CENTER_RIGHT"
                  HBox.hgrow="ALWAYS"
                  spacing="3">

                <Label text="BANKING SERVICES"
                       style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #A77B94;" />

                <Label text="Bill Payments"
                       style="-fx-font-size: 12px; -fx-text-fill: #563B4D;" />
            </VBox>

            <Button fx:id="backBtn"
                    text="Return to Dashboard"
                    onAction="#goBack"
                    prefHeight="36"
                    style="-fx-background-color: #FFF0F5; -fx-text-fill: #8D285D; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-color: #E8D3DF; -fx-border-radius: 8; -fx-cursor: hand;" />

        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background: #F8F5F8; -fx-background-color: #F8F5F8; -fx-border-color: transparent;">

            <content>
                <VBox alignment="TOP_CENTER"
                      spacing="18"
                      style="-fx-padding: 22 35 25 35;">

                    <VBox spacing="7"
                          maxWidth="800"
                          style="-fx-background-color: #8D285D; -fx-background-radius: 13; -fx-padding: 20 24;">

                        <Label text="BILL PAYMENTS"
                               style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #F8DCEB;" />

                        <Label text="Pay your bills with ease."
                               style="-fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: white;" />

                        <Label text="Manage your payments from one convenient place."
                               style="-fx-font-size: 12px; -fx-text-fill: #FFE1EE;" />
                    </VBox>

                    <VBox spacing="18"
                          maxWidth="800"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 24; -fx-border-color: #F0E4EC; -fx-border-radius: 12;">

                        <VBox spacing="5">
                            <Label text="MAKE A PAYMENT"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #432C3B;" />

                            <Label text="Complete the details below to pay your bill."
                                   style="-fx-font-size: 12px; -fx-text-fill: #98758A;" />
                        </VBox>

                        <HBox spacing="18"
                              alignment="CENTER_LEFT">

                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS"
                                  maxWidth="Infinity">

                                <Label text="PAY FROM ACCOUNT"
                                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #70445E;" />

                                <ChoiceBox fx:id="billAccountBox"
                                           prefHeight="43"
                                           maxWidth="Infinity"
                                           style="-fx-background-color: #FFF9FC; -fx-background-radius: 8; -fx-border-color: #E8D3DF; -fx-border-radius: 8;" />
                            </VBox>

                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS"
                                  maxWidth="Infinity">

                                <Label text="BILL TYPE"
                                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #70445E;" />

                                <ChoiceBox fx:id="billTypeBox"
                                           prefHeight="43"
                                           maxWidth="Infinity"
                                           style="-fx-background-color: #FFF9FC; -fx-background-radius: 8; -fx-border-color: #E8D3DF; -fx-border-radius: 8;" />
                            </VBox>

                        </HBox>

                        <HBox spacing="18"
                              alignment="CENTER_LEFT">

                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS"
                                  maxWidth="Infinity">

                                <Label text="REFERENCE / METER NUMBER"
                                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #70445E;" />

                                <TextField fx:id="billAccountField"
                                           promptText="Account or Meter Number"
                                           prefHeight="43"
                                           style="-fx-background-color: #FFF9FC; -fx-background-radius: 9; -fx-border-color: #E8D3DF; -fx-border-radius: 9; -fx-border-width: 1; -fx-padding: 0 13; -fx-font-size: 13px; -fx-text-fill: #432C3B;" />
                            </VBox>

                            <VBox spacing="8"
                                  HBox.hgrow="ALWAYS"
                                  maxWidth="Infinity">

                                <Label text="AMOUNT (BWP)"
                                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #70445E;" />

                                <TextField fx:id="billAmountField"
                                           promptText="Enter amount, e.g. 250.00"
                                           prefHeight="43"
                                           style="-fx-background-color: #FFF9FC; -fx-background-radius: 9; -fx-border-color: #E8D3DF; -fx-border-radius: 9; -fx-border-width: 1; -fx-padding: 0 13; -fx-font-size: 13px; -fx-text-fill: #432C3B;" />
                            </VBox>

                        </HBox>

                        <Button fx:id="payBtn"
                                text="Pay Now"
                                onAction="#payBill"
                                maxWidth="Infinity"
                                prefHeight="45"
                                style="-fx-background-color: #8D285D; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 9; -fx-cursor: hand;" />

                        <Label fx:id="paymentStatus"
                               text=""
                               wrapText="true"
                               maxWidth="Infinity"
                               style="-fx-text-fill: #C52262; -fx-font-size: 12px; -fx-font-weight: bold;" />

                    </VBox>

                </VBox>
            </content>

        </ScrollPane>
    </center>

</BorderPane>
