<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.TransferController"
            prefWidth="620"
            prefHeight="645"
            style="-fx-background-color: #F8F5F8;">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              prefHeight="68"
              style="-fx-background-color: white; -fx-padding: 12 28; -fx-border-color: #F0E4EC; -fx-border-width: 0 0 1 0;">

            <VBox spacing="2">
                <Label text="SASHA BANK"
                       style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #8D285D;" />

                <Label text="PERSONAL BANKING"
                       style="-fx-font-size: 10px; -fx-text-fill: #A77B94;" />
            </VBox>

            <VBox alignment="CENTER_RIGHT"
                  HBox.hgrow="ALWAYS"
                  spacing="3">
                <Label text="BANKING SERVICES"
                       style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #A77B94;" />

                <Label text="Account Transfers"
                       style="-fx-font-size: 12px; -fx-text-fill: #563B4D;" />
            </VBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background: #F8F5F8; -fx-background-color: #F8F5F8; -fx-border-color: transparent;">

            <content>
                <VBox alignment="TOP_CENTER"
                      spacing="17"
                      style="-fx-padding: 24 34 24 34;">

                    <VBox spacing="7"
                          maxWidth="Infinity"
                          style="-fx-background-color: #8D285D; -fx-background-radius: 13; -fx-padding: 20 24;">

                        <Label text="MONEY TRANSFER"
                               style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #F8DCEB;" />

                        <Label text="Move money effortlessly."
                               wrapText="true"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />

                        <Label text="Transfer funds between your banking accounts."
                               wrapText="true"
                               style="-fx-font-size: 12px; -fx-text-fill: #FFE1EE;" />
                    </VBox>

                    <GridPane hgap="14"
                              maxWidth="Infinity">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" />
                            <ColumnConstraints percentWidth="50" />
                        </columnConstraints>

                        <VBox GridPane.columnIndex="0"
                              spacing="10"
                              maxWidth="Infinity"
                              minWidth="0"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 17; -fx-border-color: #F0E4EC; -fx-border-radius: 12;">

                            <Label text="FROM ACCOUNT"
                                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #8D285D;" />

                            <ComboBox fx:id="fromAccountSelect"
                                      onAction="#updateFromAccount"
                                      promptText="Select source account"
                                      prefHeight="40"
                                      maxWidth="Infinity"
                                      style="-fx-background-color: #FFF9FC; -fx-background-radius: 8; -fx-border-color: #E8D3DF; -fx-border-radius: 8;" />

                            <Label text="AVAILABLE BALANCE"
                                   style="-fx-font-size: 10px; -fx-text-fill: #A77B94;" />

                            <Label fx:id="fromBalanceLabel"
                                   text="Balance: P0.00"
                                   wrapText="true"
                                   maxWidth="Infinity"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #8D285D;" />
                        </VBox>

                        <VBox GridPane.columnIndex="1"
                              spacing="10"
                              maxWidth="Infinity"
                              minWidth="0"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 17; -fx-border-color: #F0E4EC; -fx-border-radius: 12;">

                            <Label text="TO ACCOUNT"
                                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #8D285D;" />

                            <ComboBox fx:id="toAccountSelect"
                                      onAction="#updateToAccount"
                                      promptText="Select destination account"
                                      prefHeight="40"
                                      maxWidth="Infinity"
                                      style="-fx-background-color: #FFF9FC; -fx-background-radius: 8; -fx-border-color: #E8D3DF; -fx-border-radius: 8;" />

                            <Label text="AVAILABLE BALANCE"
                                   style="-fx-font-size: 10px; -fx-text-fill: #A77B94;" />

                            <Label fx:id="toBalanceLabel"
                                   text="Balance: P0.00"
                                   wrapText="true"
                                   maxWidth="Infinity"
                                   style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #8D285D;" />
                        </VBox>

                    </GridPane>

                    <VBox spacing="13"
                          maxWidth="Infinity"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #F0E4EC; -fx-border-radius: 12;">

                        <Label text="TRANSFER AMOUNT (BWP)"
                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #70445E;" />

                        <TextField fx:id="amountField"
                                   promptText="Enter amount, e.g. 250.00"
                                   prefHeight="44"
                                   style="-fx-background-color: #FFF9FC; -fx-background-radius: 9; -fx-border-color: #E8D3DF; -fx-border-radius: 9; -fx-border-width: 1; -fx-padding: 0 13; -fx-font-size: 14px; -fx-text-fill: #432C3B;" />

                        <Button fx:id="transferButton"
                                text="Transfer Funds"
                                onAction="#handleTransfer"
                                maxWidth="Infinity"
                                prefHeight="43"
                                style="-fx-background-color: #8D285D; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 9; -fx-cursor: hand;" />
                    </VBox>

                    <Button text="Return to Dashboard"
                            onAction="#goBack"
                            maxWidth="Infinity"
                            prefHeight="40"
                            style="-fx-background-color: #FFF0F5; -fx-text-fill: #8D285D; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 9; -fx-border-color: #E8D3DF; -fx-border-radius: 9; -fx-cursor: hand;" />

                </VBox>
            </content>

        </ScrollPane>
    </center>

</BorderPane>
