<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AdminCreateCompanyController"
      spacing="25" alignment="CENTER"
      style="-fx-background-color:#F8F5F8; -fx-padding:30;">

    <!-- Title -->
    <Label text="Create Company Account"
           style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#8D285D;" />

    <!-- White Card -->
    <VBox spacing="20" alignment="CENTER"
          prefWidth="480"
          style="-fx-background-color:white;
                 -fx-padding:25;
                 -fx-background-radius:12;
                 -fx-border-color:#F0E4EC;
                 -fx-border-radius:12;">

        <!-- Form Layout -->
        <GridPane hgap="15" vgap="12">

            <!-- Company Name -->
            <Label text="Company Name:" GridPane.rowIndex="0"
                   style="-fx-text-fill:#70445E;" />
            <TextField fx:id="companyNameField" GridPane.columnIndex="1" GridPane.rowIndex="0"
                       promptText="Enter company name"
                       style="-fx-background-color:#FFF9FC; -fx-background-radius:8; -fx-border-radius:8; -fx-border-color:#E8D3DF; -fx-text-fill:#432C3B;" />

            <!-- Business ID -->
            <Label text="Business ID:" GridPane.rowIndex="1"
                   style="-fx-text-fill:#70445E;" />
            <TextField fx:id="businessIdField" GridPane.columnIndex="1" GridPane.rowIndex="1"
                       promptText="Enter business ID"
                       style="-fx-background-color:#FFF9FC; -fx-background-radius:8; -fx-border-radius:8; -fx-border-color:#E8D3DF; -fx-text-fill:#432C3B;" />

            <!-- Registration Number -->
            <Label text="Registration Number:" GridPane.rowIndex="2"
                   style="-fx-text-fill:#70445E;" />
            <TextField fx:id="regNumberField" GridPane.columnIndex="1" GridPane.rowIndex="2"
                       promptText="Enter registration number"
                       style="-fx-background-color:#FFF9FC; -fx-background-radius:8; -fx-border-radius:8; -fx-border-color:#E8D3DF; -fx-text-fill:#432C3B;" />

            <!-- Registration Date -->
            <Label text="Registration Date:" GridPane.rowIndex="3"
                   style="-fx-text-fill:#70445E;" />
            <DatePicker fx:id="regDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="3"
                        style="-fx-background-color:#FFF9FC; -fx-background-radius:8; -fx-border-radius:8; -fx-border-color:#E8D3DF;" />

            <!-- Starting Capital -->
            <Label text="Starting Capital (P):" GridPane.rowIndex="4"
                   style="-fx-text-fill:#70445E;" />
            <TextField fx:id="capitalField" GridPane.columnIndex="1" GridPane.rowIndex="4"
                       promptText="e.g. 50000"
                       style="-fx-background-color:#FFF9FC; -fx-background-radius:8; -fx-border-radius:8; -fx-border-color:#E8D3DF; -fx-text-fill:#432C3B;" />

        </GridPane>

        <!-- Create Button -->
        <Button text="Create Company Account"
                onAction="#handleCreateCompany"
                prefWidth="260" prefHeight="45"
                style="-fx-background-color:#8D285D; -fx-text-fill:white;
                       -fx-font-size:16px; -fx-background-radius:10;" />

    </VBox>

    <!-- Back Button -->
    <Button text="Back to Admin Dashboard"
            onAction="#goBack"
            prefWidth="220" prefHeight="40"
            style="-fx-background-color:#FFF0F5; -fx-text-fill:#8D285D;
                   -fx-border-color:#E8D3DF; -fx-border-radius:10;
                   -fx-background-radius:10; -fx-font-size:14px;" />

</VBox>
