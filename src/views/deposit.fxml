<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.DepositController"
            prefWidth="620"
            prefHeight="645"
            style="-fx-background-color: #F8F5F8;">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              prefHeight="68"
              style="-fx-background-color: white; -fx-padding: 12 28; -fx-border-color: #F0E4EC; -fx-border-width: 0 0 1 0;">

            <VBox spacing="2">
                <Label text="SASHA BANK"
                       style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: #8D285D;" />

                <Label text="PERSONAL BANKING"
                       style="-fx-font-size: 10px; -fx-text-fill: #A77B94;" />
            </VBox>

            <VBox alignment="CENTER_RIGHT"
                  HBox.hgrow="ALWAYS"
                  spacing="3">

                <Label text="BANKING SERVICES"
                       style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #A77B94;" />

                <Label text="Account Deposits"
                       style="-fx-font-size: 12px; -fx-text-fill: #563B4D;" />
            </VBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background: #F8F5F8; -fx-background-color: #F8F5F8; -fx-border-color: transparent;">

            <content>
                <VBox alignment="TOP_CENTER"
                      spacing="17"
                      style="-fx-padding: 24 34 24 34;">

                    <VBox spacing="7"
                          maxWidth="Infinity"
                          style="-fx-background-color: #8D285D; -fx-background-radius: 13; -fx-padding: 20 24;">

                        <Label text="ACCOUNT DEPOSIT"
                               style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #F8DCEB;" />

                        <Label text="Grow your balance with ease."
                               wrapText="true"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;" />

                        <Label text="Select your account and enter the amount you wish to deposit."
                               wrapText="true"
                               style="-fx-font-size: 12px; -fx-text-fill: #FFE1EE;" />
                    </VBox>

                    <HBox spacing="14"
                          alignment="CENTER"
                          maxWidth="Infinity">

                        <VBox spacing="11"
                              HBox.hgrow="ALWAYS"
                              maxWidth="Infinity"
                              minWidth="0"
                              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #F0E4EC; -fx-border-radius: 12;">

                            <Label text="SELECT ACCOUNT"
                                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #8D285D;" />

                            <ComboBox fx:id="accountSelect"
                                      onAction="#updateSelectedAccount"
                                      promptText="Choose an account"
                                      prefHeight="42"
                                      maxWidth="Infinity"
                                      style="-fx-background-color: #FFF9FC; -fx-background-radius: 8; -fx-border-color: #E8D3DF; -fx-border-radius: 8;" />

                            <Label text="Choose the account to deposit into."
                                   wrapText="true"
                                   style="-fx-font-size: 11px; -fx-text-fill: #98758A;" />
                        </VBox>

                        <VBox spacing="11"
                              HBox.hgrow="ALWAYS"
                              maxWidth="Infinity"
                              minWidth="0"
                              style="-fx-background-color: #FFF0F6; -fx-background-radius: 12; -fx-padding: 18; -fx-border-color: #F2D4E1; -fx-border-radius: 12;">

                            <Label text="AVAILABLE BALANCE"
                                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #A77B94;" />

                            <Label fx:id="balanceLabel"
                                   text="Balance: P0.00"
                                   wrapText="true"
                                   maxWidth="Infinity"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #8D285D;" />

                            <Label text="Current funds in your selected account."
                                   wrapText="true"
                                   style="-fx-font-size: 11px; -fx-text-fill: #98758A;" />
                        </VBox>

                    </HBox>

                    <VBox spacing="14"
                          maxWidth="Infinity"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #F0E4EC; -fx-border-radius: 12;">

                        <VBox spacing="8">

                            <Label text="DEPOSIT AMOUNT (BWP)"
                                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #70445E;" />

                            <TextField fx:id="amountField"
                                       promptText="Enter amount, e.g. 250.00"
                                       prefHeight="44"
                                       style="-fx-background-color: #FFF9FC; -fx-background-radius: 9; -fx-border-color: #E8D3DF; -fx-border-radius: 9; -fx-border-width: 1; -fx-padding: 0 13; -fx-font-size: 14px; -fx-text-fill: #432C3B;" />

                        </VBox>

                        <Button fx:id="depositButton"
                                text="Deposit Funds"
                                onAction="#handleDeposit"
                                maxWidth="Infinity"
                                prefHeight="42"
                                style="-fx-background-color: #8D285D; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 9; -fx-cursor: hand;" />

                    </VBox>

                    <Button text="Return to Dashboard"
                            onAction="#goBack"
                            maxWidth="Infinity"
                            prefHeight="40"
                            style="-fx-background-color: #FFF0F5; -fx-text-fill: #8D285D; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 9; -fx-border-color: #E8D3DF; -fx-border-radius: 9; -fx-cursor: hand;" />

                </VBox>
            </content>

        </ScrollPane>
    </center>

</BorderPane>
