<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AdminCreateCustomerController"
      spacing="25" alignment="CENTER"
      style="-fx-background-color:#F8F5F8; -fx-padding:30;">

    <Label text="Create Customer Account"
           style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:#8D285D;" />

    <GridPane hgap="20" vgap="12">

        <Label text="Full Name:"
               style="-fx-text-fill:#70445E;" />
        <TextField fx:id="fullNameField"
                   GridPane.columnIndex="1"
                   style="-fx-background-color:#FFF9FC; -fx-border-color:#E8D3DF; -fx-border-radius:8; -fx-background-radius:8; -fx-text-fill:#432C3B;" />

        <Label text="Username:" GridPane.rowIndex="1"
               style="-fx-text-fill:#70445E;" />
        <TextField fx:id="usernameField"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"
                   style="-fx-background-color:#FFF9FC; -fx-border-color:#E8D3DF; -fx-border-radius:8; -fx-background-radius:8; -fx-text-fill:#432C3B;" />

        <Label text="Password:" GridPane.rowIndex="2"
               style="-fx-text-fill:#70445E;" />
        <PasswordField fx:id="passwordField"
                       GridPane.columnIndex="1" GridPane.rowIndex="2"
                       style="-fx-background-color:#FFF9FC; -fx-border-color:#E8D3DF; -fx-border-radius:8; -fx-background-radius:8; -fx-text-fill:#432C3B;" />

        <Label text="Place of Birth:" GridPane.rowIndex="3"
               style="-fx-text-fill:#70445E;" />
        <TextField fx:id="birthPlaceField"
                   GridPane.columnIndex="1" GridPane.rowIndex="3"
                   style="-fx-background-color:#FFF9FC; -fx-border-color:#E8D3DF; -fx-border-radius:8; -fx-background-radius:8; -fx-text-fill:#432C3B;" />

        <Label text="Date of Birth:" GridPane.rowIndex="4"
               style="-fx-text-fill:#70445E;" />
        <DatePicker fx:id="dobPicker"
                    GridPane.columnIndex="1" GridPane.rowIndex="4"
                    style="-fx-background-color:#FFF9FC; -fx-border-color:#E8D3DF; -fx-border-radius:8; -fx-background-radius:8;" />

        <Label text="National ID:" GridPane.rowIndex="5"
               style="-fx-text-fill:#70445E;" />
        <TextField fx:id="idNumberField"
                   GridPane.columnIndex="1" GridPane.rowIndex="5"
                   style="-fx-background-color:#FFF9FC; -fx-border-color:#E8D3DF; -fx-border-radius:8; -fx-background-radius:8; -fx-text-fill:#432C3B;" />

        <Label text="Phone Number:" GridPane.rowIndex="6"
               style="-fx-text-fill:#70445E;" />
        <TextField fx:id="phoneField"
                   GridPane.columnIndex="1" GridPane.rowIndex="6"
                   style="-fx-background-color:#FFF9FC; -fx-border-color:#E8D3DF; -fx-border-radius:8; -fx-background-radius:8; -fx-text-fill:#432C3B;" />

        <Label text="Email Address:" GridPane.rowIndex="7"
               style="-fx-text-fill:#70445E;" />
        <TextField fx:id="emailField"
                   GridPane.columnIndex="1" GridPane.rowIndex="7"
                   style="-fx-background-color:#FFF9FC; -fx-border-color:#E8D3DF; -fx-border-radius:8; -fx-background-radius:8; -fx-text-fill:#432C3B;" />

        <Label text="Address:" GridPane.rowIndex="8"
               style="-fx-text-fill:#70445E;" />
        <TextField fx:id="addressField"
                   GridPane.columnIndex="1" GridPane.rowIndex="8"
                   style="-fx-background-color:#FFF9FC; -fx-border-color:#E8D3DF; -fx-border-radius:8; -fx-background-radius:8; -fx-text-fill:#432C3B;" />

        <Label text="Gender:" GridPane.rowIndex="9"
               style="-fx-text-fill:#70445E;" />
        <ComboBox fx:id="genderCombo"
                  GridPane.columnIndex="1" GridPane.rowIndex="9"
                  prefWidth="200"
                  style="-fx-background-color:#FFF9FC; -fx-border-color:#E8D3DF; -fx-border-radius:8; -fx-background-radius:8;" />

        <Label text="Account Type:" GridPane.rowIndex="10"
               style="-fx-text-fill:#70445E;" />
        <ComboBox fx:id="accountTypeCombo"
                  GridPane.columnIndex="1" GridPane.rowIndex="10"
                  prefWidth="200"
                  style="-fx-background-color:#FFF9FC; -fx-border-color:#E8D3DF; -fx-border-radius:8; -fx-background-radius:8;" />

        <Label text="Initial Amount:" GridPane.rowIndex="11"
               style="-fx-text-fill:#70445E;" />
        <TextField fx:id="initialAmountField"
                   GridPane.columnIndex="1" GridPane.rowIndex="11"
                   style="-fx-background-color:#FFF9FC; -fx-border-color:#E8D3DF; -fx-border-radius:8; -fx-background-radius:8; -fx-text-fill:#432C3B;" />

    </GridPane>

    <Button text="Create Customer"
            onAction="#createCustomer"
            prefWidth="260" prefHeight="40"
            style="-fx-background-color:#8D285D; -fx-text-fill:white;
                   -fx-font-size:16px; -fx-background-radius:10;" />

    <Button text="Back"
            onAction="#backToDashboard"
            prefWidth="200" prefHeight="40"
            style="-fx-background-color:#FFF0F5; -fx-text-fill:#8D285D;
                   -fx-border-color:#E8D3DF; -fx-border-radius:10;
                   -fx-background-radius:10; -fx-font-size:14px;" />

</VBox>
